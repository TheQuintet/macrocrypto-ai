# ============================================================
# AI SERVICE ENVIRONMENT CONFIGURATION
# ============================================================
# This file is a template. Copy it to `.env` and adjust as
# needed. Every setting here maps to a field in app/config.py.
#
# Variables are read in this priority order (highest first):
#   1. Environment variables (e.g. exported in the shell)
#   2. The .env file in the service working directory
#   3. Field defaults in app/config.py
# ============================================================

# ============================================================
# SERVICE
# ============================================================
SERVICE_NAME=ai-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================
# DATABASE (TimescaleDB)
# ============================================================
DATABASE_URL=postgresql://macro:crypto@postgres:5432/macrocrypto

# Source table names (written by the Data Ingestion Service)
DB_TABLE_BTC_PRICES=btc_prices
DB_TABLE_MACRO_INDICATORS=macro_indicators

# Target table name (written by AI Service)
DB_TABLE_PREDICTIONS=btc_predictions

# ============================================================
# FEATURE SOURCE
# ============================================================
# Where training and prediction features come from.
#
# Supported values:
#   "parquet"      — data-service parquet files (50 features).
#                    Used by the manual CLI file-path pipeline.
#   "features_db"  — the future DB table (50 features, live-updated).
#                    Target production source.
#
# Both sources provide the same canonical 50-feature contract.
# The legacy 10-feature path (btc_prices + macro_indicators) is
# NOT a supported option.
FEATURE_SOURCE=features_db

# Directory containing data-service parquet files.
# Used when FEATURE_SOURCE=parquet.
# The AI Service must be able to read this directory (mount it
# as a read-only volume in Docker/K8s).
SHARED_DATA_DIR=/app/shared/features

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_FORECAST_TTL=3600

# ============================================================
# RABBITMQ
# ============================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Exchange
RABBITMQ_EXCHANGE=macrocrypto

# Queues
RABBITMQ_PRICE_QUEUE=ai.price.queue
RABBITMQ_INDICATOR_QUEUE=ai.indicator.queue

# Routing keys
RABBITMQ_PRICE_ROUTING_KEY=*.price.*
RABBITMQ_INDICATOR_ROUTING_KEY=*.economic.*
RABBITMQ_PREDICTION_ROUTING_KEY=intelligence.forecast.generated

# ============================================================
# MLFLOW
# ============================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=macrocrypto_ai
MLFLOW_MODEL_NAME=prophet_btc_forecast

# ============================================================
# MODEL PARAMETERS
# ============================================================
# DEPRECATED (see known_issues.md #13): the settings below are
# not read by any code path. Kept here for reference during the
# current migration; they will be removed once the future
# feature pipeline is in place.
MODEL_TRAINING_DAYS=90
MODEL_FORECAST_HORIZON_HOURS=24
MODEL_FORECAST_HORIZON_DAYS=7
MODEL_CHANGEPOINT_PRIOR=0.05
MODEL_SEASONALITY_PRIOR=10.0
MODEL_HOLIDAYS_PRIOR=10.0

# Model artifact storage
MODEL_SAVE_DIR=models
PROPHET_24H_MODEL_FILENAME=prophet_24h.json
PROPHET_7D_MODEL_FILENAME=prophet_7d.json

# ============================================================
# PERFORMANCE THRESHOLDS
# ============================================================
# MAE/RMSE thresholds are decimal fractions of mean price
# (0.10 = 10%). MAPE and directional are already percentages.
THRESHOLD_MAE=0.10
THRESHOLD_RMSE=0.15
THRESHOLD_MAPE=10.0
THRESHOLD_DIRECTIONAL=55.0

# ============================================================
# THRESHOLD WARNING STREAKS (T5.6)
# ============================================================
# A warning is emitted when a metric has breached its threshold
# for this many consecutive days.
THRESHOLD_WARNING_STREAK_DAYS=3

# ============================================================
# MARKET CONDITION THRESHOLDS (T5.3)
# ============================================================
# Bull market: cumulative return > +20% over the forecast window
MARKET_BULL_THRESHOLD_PCT=20.0
# Bear market: cumulative return < -20% over the forecast window
MARKET_BEAR_THRESHOLD_PCT=20.0
# Volatile market: std of percentage returns > 5% (decimal form)
MARKET_VOLATILITY_THRESHOLD=0.05

# ============================================================
# SCHEDULING
# ============================================================
RETRAIN_HOUR=6
RETRAIN_MINUTE=0
RETRAIN_TIMEZONE=UTC

# DEPRECATED: not read by any code path. See known_issues.md #13.
WALK_FORWARD_DAYS=30

# ------------------------------------------------------------
# Scheduler toggles
# ------------------------------------------------------------
# Master switch for the entire scheduler. When false, no jobs
# run, even if the category toggles below are true.
SCHEDULER_ENABLED=true

# ML pipeline jobs — 7 jobs that depend on trained models:
#   - daily_retrain
#   - hourly_prediction
#   - daily_7d_prediction
#   - daily_backtest
#   - daily_accuracy
#   - daily_multi_model_predictions
#   - daily_model_performance_aggregation
#
# Default: false. Enable once the live path is ready to run
# against the features_db source.
SCHEDULER_ML_JOBS_ENABLED=false

# Analytics + housekeeping jobs — 3 independent jobs that do
# not depend on trained models:
#   - daily_correlation
#   - daily_event_impact_update
#   - daily_export_cleanup
#
# Default: true.
SCHEDULER_ANALYTICS_JOBS_ENABLED=true

# Retention of in-memory job history entries
SCHEDULER_HISTORY_MAX_ENTRIES=100

# Retries per job run on failure (0 = no retry)
SCHEDULER_MAX_RETRIES=1

# ------------------------------------------------------------
# Per-job schedules (all UTC)
# ------------------------------------------------------------
# 7d prediction job (daily at 6:30 AM UTC, after retrain)
PREDICTION_7D_HOUR=6
PREDICTION_7D_MINUTE=30

# Backtest job (daily at 6:45 AM UTC, after 7d prediction)
BACKTEST_HOUR=6
BACKTEST_MINUTE=45

# Accuracy check job (daily at 7:00 AM UTC, after backtest)
ACCURACY_HOUR=7
ACCURACY_MINUTE=0

# Multi-model prediction job (daily at 6:15 AM UTC)
MULTI_MODEL_PREDICTION_HOUR=6
MULTI_MODEL_PREDICTION_MINUTE=15

# Model-performance aggregation job (daily at 7:15 AM UTC)
MODEL_PERFORMANCE_AGGREGATION_HOUR=7
MODEL_PERFORMANCE_AGGREGATION_MINUTE=15

# Correlation calculation job (daily at 2:00 AM UTC)
CORRELATION_HOUR=2
CORRELATION_MINUTE=0

# Event impact update job (daily at 4:00 AM UTC)
EVENT_IMPACT_HOUR=4
EVENT_IMPACT_MINUTE=0

# ============================================================
# BACKTEST PARAMETERS
# ============================================================
# Number of walk-forward iterations (days)
BACKTEST_ITERATIONS=30

# Number of hours of history to fetch for backtesting
# (must be >= backtest_iterations * 24 + max lag)
BACKTEST_HISTORY_HOURS=2880

# If true, evaluate the full forecast trajectory.
# If false, evaluate only the endpoint.
BACKTEST_FULL_TRAJECTORY=true

# Temporary directory for chained warm-start models between iterations
BACKTEST_MODEL_DIR=models/backtest

# ============================================================
# EXPORT STORAGE (A2.6)
# ============================================================
# Backend selector. Only "local" is implemented in A2.6.
EXPORT_STORAGE_BACKEND=local

# Directory where locally-stored export files live.
# Relative paths are resolved against the current working directory.
EXPORT_STORAGE_DIR=exports

# How long a download link remains valid, in seconds.
EXPORT_LINK_TTL_SECONDS=604800

# How long a stored file remains on disk before the cleanup job
# deletes it, in seconds.
EXPORT_FILE_TTL_SECONDS=604800

# ============================================================
# ACCURACY JOB PARAMETERS (T5.4)
# ============================================================
# Look-back window for accuracy checks (in days)
ACCURACY_LOOKBACK_DAYS=7