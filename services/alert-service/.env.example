# ============================================
# SERVICE CONFIGURATION
# ============================================

# Service identification
SERVICE_NAME=alert-service
SERVICE_PORT=8003
LOG_LEVEL=INFO

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string (for alert rules and history)
# In Docker: use service name 'postgres'
# Locally: use 'localhost'
DATABASE_URL=postgresql://macro:crypto@postgres:5432/macrocrypto
# DATABASE_URL=postgresql://macro:crypto@localhost:5432/macrocrypto  # Local development

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================
# REDIS CONFIGURATION
# ============================================

# Enable/disable Redis caching
REDIS_ENABLED=true

# Redis connection settings
# In Docker: use service name 'redis'
# Locally: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Alternative: Full Redis URL
# REDIS_URL=redis://redis:6379/0

# Cache TTL in seconds
REDIS_CACHE_TTL=300

# ============================================
# RABBITMQ CONFIGURATION
# ============================================

# RabbitMQ connection settings
# In Docker: use service name 'rabbitmq'
# Locally: use 'localhost'
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Alternative: Full RabbitMQ URL
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ============================================
# ALERT SERVICE SPECIFIC CONFIGURATION
# ============================================

# Alert checking interval (seconds)
# How often to evaluate alert rules
ALERT_CHECK_INTERVAL=60

# Maximum alerts per user (rate limiting)
MAX_ALERTS_PER_USER=50

# Alert history retention (days)
ALERT_RETENTION_DAYS=30

# ============================================
# NOTIFICATION CONFIGURATION
# ============================================

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@macrocrypto.ai
SMTP_FROM_NAME=MacroCrypto AI Alerts

# SMS notifications (Twilio) - Optional
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Slack notifications - Optional
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ============================================
# LOGGING & MONITORING
# ============================================

LOG_LEVEL=INFO

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

RELOAD=true
DEBUG=false