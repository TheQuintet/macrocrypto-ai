# ============================================
# SERVICE CONFIGURATION
# ============================================
SERVICE_NAME=api-gateway
SERVICE_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=macro
POSTGRES_PASSWORD=crypto
POSTGRES_DB=macrocrypto
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ============================================
# REDIS (Session, Rate Limiting, Cache)
# ============================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=3600
REDIS_RATE_LIMIT_TTL=60

# ============================================
# RABBITMQ (Event Consumer/Producer)
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=macro_events

# ============================================
# INTERNAL SERVICES
# ============================================
DATA_SERVICE_URL=http://data-service:8001
AI_SERVICE_URL=http://ai-service:8002
ALERT_SERVICE_URL=http://alert-service:8003

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_GUEST=10
RATE_LIMIT_USER=100
RATE_LIMIT_ADMIN=1000

# ============================================
# JWT / AUTHENTICATION
# ============================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================
# CORS
# ============================================
# Local dev and the deployed Cloudflare Worker frontend
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8000","https://macrocrypto-ai.lgloredanaelena.workers.dev"]
CORS_ALLOW_CREDENTIALS=true

# ============================================
# DEVELOPMENT
# ============================================
RELOAD=true
DEBUG=false