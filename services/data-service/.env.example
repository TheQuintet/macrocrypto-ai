# ============================================
# SERVICE CONFIGURATION
# ============================================

# Service identification
SERVICE_NAME=data-service
SERVICE_PORT=8001
LOG_LEVEL=INFO

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string
# In Docker: use service name 'postgres'
# Locally: use 'localhost'
DATABASE_URL=postgresql://macro:crypto@postgres:5432/macrocrypto
# DATABASE_URL=postgresql://macro:crypto@localhost:5432/macrocrypto  # Local development

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================
# REDIS CONFIGURATION
# ============================================

# Enable/disable Redis caching
# Set to "false" to disable Redis (useful for local development without Redis)
# Defaults to "true" if not set
REDIS_ENABLED=true

# Redis connection settings (used when REDIS_ENABLED=true)
# In Docker: use service name 'redis'
# Locally: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Alternative: Full Redis URL (overrides individual settings)
# In Docker: redis://redis:6379/0
# Locally: redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0

# Cache TTL in seconds
# - 300 seconds = 5 minutes (good for price data)
# - 3600 seconds = 1 hour (good for economic data)
REDIS_CACHE_TTL=300

# ============================================
# RABBITMQ CONFIGURATION
# ============================================

# RabbitMQ connection settings
# In Docker: use service name 'rabbitmq'
# Locally: use 'localhost'
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Alternative: Full RabbitMQ URL
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ============================================
# BINANCE API (Primary Crypto Data Source)
# ============================================

# REST API endpoints
BINANCE_REST_URL=https://api.binance.com/api/v3
BINANCE_TESTNET_URL=https://testnet.binance.vision/api/v3
# Set to true to use testnet (for development/testing)
BINANCE_USE_TESTNET=false

# WebSocket endpoints
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_WS_TESTNET_URL=wss://testnet.binance.vision/ws

# Rate limiting (respect Binance API limits)
BINANCE_RATE_LIMIT_PER_MINUTE=1200

# Default trading symbol
BINANCE_DEFAULT_SYMBOL=BTCUSDT

# ============================================
# FRED API (Economic Indicators)
# ============================================

FRED_API_URL=https://api.stlouisfed.org/fred
# Get your API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_api_key_here

# ============================================
# DATA COLLECTION INTERVALS
# ============================================

# How often to collect data (in seconds)
# Price collection: 60 seconds = 1 minute
PRICE_COLLECTION_INTERVAL=60

# Economic data collection: 3600 seconds = 1 hour
ECONOMIC_COLLECTION_INTERVAL=3600

# WebSocket reconnect delay (seconds)
WEBSOCKET_RECONNECT_DELAY=5

# Real-time WebSocket data is always streaming

# ============================================
# LOGGING & MONITORING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# RATE LIMITING
# ============================================

# Enable rate limiting for API endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# Enable hot-reload for development (set to false in production)
RELOAD=true
DEBUG=false