# API Gateway base URL used by every HTTP, SSE, and WebSocket client.
# Local docker-compose: http://localhost:8000
# Leave unset to run the frontend standalone on simulated data.
# Restart `npm run dev` after changing this file.
# Live BTC price WebSocket (no user_id): ws://localhost:8000/api/v1/btc/price/stream
# In DevTools open Network → filter "WS" or "Socket" (not Fetch/XHR).
VITE_API_GATEWAY_BASE_URL=
