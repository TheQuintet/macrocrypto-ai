# Data service base URL. Leave unset to run the frontend standalone on
# simulated data (labelled "Simulated" in the UI).
# Local docker-compose: http://localhost:8001
VITE_API_BASE_URL=

# Alert service base URL. Leave unset to use simulated alerts.
# Local docker-compose: http://localhost:8003
VITE_ALERT_API_BASE_URL=

# Gateway price stream URL. Leave unset to use the simulated socket.
# VITE_PRICE_WS_URL=ws://localhost:8001/api/v1/btc/price/stream

# Alert-service notification stream (SSE http(s) or WebSocket ws(s)).
# Leave unset to skip notification HTTP/stream and use simulated inbox data.
# Local docker-compose (once the route exists):
# VITE_NOTIFICATION_STREAM_URL=http://localhost:8003/api/v1/notifications/stream
