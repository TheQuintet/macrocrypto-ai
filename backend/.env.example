# Redis configuration
# Used for API caching layer
#
# REDIS_ENABLED: Set to "false" to disable Redis caching (useful for local development without Redis)
#                 Defaults to "true" if not set
#
# REDIS_HOST: Redis server hostname (default: localhost)
# REDIS_PORT: Redis server port (default: 6379)
# REDIS_DB: Redis database number (default: 0)

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0